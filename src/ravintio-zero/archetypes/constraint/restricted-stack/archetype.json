{
  "name": "restricted-stack",
  "kind": "constraint",
  "summary": "Fails P3 when design.md names a stack entry outside your allowlist.",
  "slots": [
    "stack-list"
  ],
  "thresholds": {},
  "gates": [
    {
      "id": "stack-allowlist",
      "type": "allowlist",
      "allow": [
        "TypeScript",
        "Node.js",
        "React",
        "PostgreSQL",
        "Redis",
        "Docker",
        "GitHub Actions"
      ]
    }
  ]
}
